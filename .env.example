# =====================================================================
# IntelliCampus Environment Configuration Template (.env.example)
# Copy this file to .env in the project root and fill in your values.
# NEVER commit the actual .env file with secrets to version control.
# =====================================================================

CLIENT_URL=http://localhost:5173

# ---------------------------------------------------------------------
# Database Configuration (MySQL 8)
# ---------------------------------------------------------------------
DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/intellicampus
DB_HOST=localhost
# Using the Docker MySQL from docker-compose (docker compose up -d db)? Set DB_PORT=3307.
# Using a MySQL installed on your laptop? Keep DB_PORT=3306.
DB_PORT=3306
DB_PORT_EXTERNAL=3307
DB_NAME=intellicampus
DB_USER=campus_admin
DB_PASSWORD=your_db_password_here
MYSQL_ROOT_PASSWORD=your_root_password_here

# ---------------------------------------------------------------------
# Email (SMTP) Configuration for Password Reset OTP
# 16-letter Gmail App Password, no spaces.
# Supports both MAIL_* and SMTP_* variable names.
# ---------------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@intellicampus.edu
# SMTP_* aliases (alternative names):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ---------------------------------------------------------------------
# Cryptographic & Security Parameters
# ---------------------------------------------------------------------
# Secret key for signing JWT tokens (min 32 characters)
JWT_SECRET=replace_with_a_long_random_secret_min_32_chars

# First-run Principal Setup Token (Optional)
# If set, the Principal must provide this token during initial self-registration at /principal/login.
# If left empty, first-time registration does not require a setup token.
SETUP_TOKEN=

# ---------------------------------------------------------------------
# Redis & Microservice Configuration (Optional)
# ---------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
AI_SERVICE_URL=http://localhost:8000

# ---------------------------------------------------------------------
# Security Hardening & Lockout Policies
# ---------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:3000
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
ADMIN_OTP_ENABLED=false
