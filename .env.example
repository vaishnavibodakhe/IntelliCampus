# =====================================================================
# IntelliCampus Master Environment Configuration
# =====================================================================

# Server Port & Web Client Origin
PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# MongoDB Connection String (Mongoose)
# Default connects to local MongoDB instance:
MONGODB_URI=mongodb://127.0.0.1:27017/intellicampus_db

# Cryptographic & JWT Security
JWT_SECRET=4f92a105c3b4e78912345678abcdef0123456789abcdef0123456789abcdef2026

# Nodemailer SMTP Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_16_digit_app_password
EMAIL_FROM="IntelliCampus Security" <noreply@intellicampus.edu>

# =====================================================================
# HOW TO GENERATE A GMAIL APP PASSWORD FOR REAL EMAILS:
# =====================================================================
# 1. Sign in to your Google Account (https://myaccount.google.com/).
# 2. Navigate to "Security" tab.
# 3. Enable "2-Step Verification" under "How you sign in to Google".
# 4. In the search bar at the top, type "App Passwords" and select it.
# 5. Enter an app name (e.g. "IntelliCampus Mailer") and click "Create".
# 6. Google will display a 16-character passcode (e.g. "abcd efgh ijkl mnop").
# 7. Copy that 16-character code into EMAIL_PASS (without spaces).
# 8. Set EMAIL_USER to your Gmail address.
# =====================================================================
