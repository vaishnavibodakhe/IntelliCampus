# =====================================================================
# IntelliCampus Master Environment Configuration
# Compliant with IC-SRS-1.0 Section 11.2
# =====================================================================

# Server Environment
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# Database Configuration (MySQL 8)
# Host runs use port 3307; Docker containers communicate on port 3306
# Note: docker-compose.yml's api service overrides these with db/3306 inside Docker
DB_PORT_EXTERNAL=3307
DB_HOST=localhost
DB_PORT=3307
DB_NAME=intellicampus_db
DB_USER=campus_admin
DB_PASSWORD=SecureCampusPassword2026!
MYSQL_ROOT_PASSWORD=RootSecurePassword2026!
DATABASE_URL=jdbc:mysql://localhost:3307/intellicampus_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true

# Redis Configuration (published on host port 6379; docker-compose api overrides with redis:6379)
REDIS_HOST=localhost
REDIS_PORT=6379

# Application URLs
APP_FRONTEND_URL=http://localhost:5173

# Email (SMTP) Configuration for Password Reset OTP
# For Gmail: Use smtp.gmail.com, port 587, and a 16-character Google App Password (requires 2-Step Verification)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password

# Cryptographic & Security Parameters (SRS 10.1)
# CRITICAL: JWT_SECRET (min 32 characters) is MANDATORY for the entire backend, including student and staff auth.
# Default secrets have been removed from source code. The server will refuse to start if this is missing or < 32 chars.
JWT_SECRET=4f92a105c3b4e78912345678abcdef0123456789abcdef0123456789abcdef2026

# SuperAdmin Initial Provisioning
# If SUPERADMIN_PASSWORD is set, an initial system administrator (admin@intellicampus.edu) is automatically provisioned.
# If omitted or empty, superadmin account seeding is skipped and a warning is logged to the console.
SUPERADMIN_PASSWORD=SuperAdminCampus2026!

TOKEN_ACCESS_MINUTES=15
TOKEN_REFRESH_DAYS=7
LOGIN_MAX_FAILURES=5
LOCK_MINUTES=15
SESSION_IDLE_MINUTES=30

# Attendance & Geofencing Parameters (SRS 11.2)
PHOTO_WINDOW_MINUTES=10
CONFIRM_TIMEOUT_SECONDS=120
GEOFENCE_DEFAULT_RADIUS_M=50
GEOFENCE_MAX_ACCURACY_M=100
ATTENDANCE_THRESHOLD_PERCENT=75
QR_SLOT_SECONDS=15

# AI Service Face & Anti-Spoofing Thresholds (SRS 11.2 - published on host port 8000; docker-compose api overrides with http://ai:8000)
AI_SERVICE_URL=http://localhost:8000
FACE_MATCH_THRESHOLD=0.45
FACE_MATCH_MARGIN=0.05
SPOOF_MIN_SCORE=0.60
PHASH_MAX_DISTANCE=8

# Early Warning ML Model Parameters (SRS 11.2)
RISK_LEVEL_MEDIUM=0.33
RISK_LEVEL_HIGH=0.66

# RAG LLM Provider (Optional OpenAI / Local Ollama)
OPENAI_API_KEY=
CHAT_MIN_SIMILARITY=0.75
