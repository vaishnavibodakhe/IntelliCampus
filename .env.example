# =====================================================================
# IntelliCampus Master Environment Configuration
# Compliant with IC-SRS-1.0 Section 11.2
# =====================================================================

# Server Environment
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# Database Configuration (MySQL 8)
DB_HOST=db
DB_PORT=3306
DB_NAME=intellicampus_db
DB_USER=campus_admin
DB_PASSWORD=SecureCampusPassword2026!
MYSQL_ROOT_PASSWORD=RootSecurePassword2026!
DATABASE_URL=jdbc:mysql://db:3306/intellicampus_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Cryptographic & Security Parameters (SRS 10.1)
JWT_SECRET=4f92a105c3b4e78912345678abcdef0123456789abcdef0123456789abcdef2026
TOKEN_ACCESS_MINUTES=15
TOKEN_REFRESH_DAYS=7
LOGIN_MAX_FAILURES=5
LOCK_MINUTES=15
SESSION_IDLE_MINUTES=30

# Attendance & Geofencing Parameters (SRS 11.2)
PHOTO_WINDOW_MINUTES=10
CONFIRM_TIMEOUT_SECONDS=120
GEOFENCE_DEFAULT_RADIUS_M=50
GEOFENCE_MAX_ACCURACY_M=100
ATTENDANCE_THRESHOLD_PERCENT=75
QR_SLOT_SECONDS=15

# AI Service Face & Anti-Spoofing Thresholds (SRS 11.2)
AI_SERVICE_URL=http://ai:8000
FACE_MATCH_THRESHOLD=0.50
FACE_MATCH_MARGIN=0.05
SPOOF_MIN_SCORE=0.60
PHASH_MAX_DISTANCE=8

# Early Warning ML Model Parameters (SRS 11.2)
RISK_LEVEL_MEDIUM=0.33
RISK_LEVEL_HIGH=0.66

# RAG LLM Provider (Optional OpenAI / Local Ollama)
OPENAI_API_KEY=
CHAT_MIN_SIMILARITY=0.75

# Frontend Feature Flags
# When false (default), the full role navbar (Admin, HOD, Faculty, Mentor, Student, Public Verifier)
# and staff controls (Audit Chain Inspector, Live session badge) are restored with per-role login.
# Set VITE_STUDENT_ONLY=true to restrict the portal strictly to the STUDENT-ONLY portal.
VITE_STUDENT_ONLY=false
