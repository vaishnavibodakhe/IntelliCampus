# =====================================================================
# IntelliCampus Environment Configuration Template (.env.example)
# Copy this file to .env in the project root and fill in your values.
# NEVER commit the actual .env file with secrets to version control.
# =====================================================================

# ---------------------------------------------------------------------
# Database Configuration (MySQL 8)
# Used by Spring Boot backend datasource (application.yml)
# ---------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=intellicampus_db
DB_USER=campus_admin
DB_PASSWORD=your_db_password_here

# ---------------------------------------------------------------------
# Email (SMTP) Configuration for Password Reset OTP
# Read by DotEnvLoader / application.yml
# ---------------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# Your Gmail address used to send verification/OTP emails
MAIL_USERNAME=
# 16-letter Gmail App Password, no spaces (e.g. abcd efgh ijkl mnop -> abcdefghijklmnop)
# Generated from: Google Account > Security > 2-Step Verification > App passwords
MAIL_PASSWORD=

# ---------------------------------------------------------------------
# Cryptographic & Security Parameters
# ---------------------------------------------------------------------
# Secret key for signing JWT tokens (min 32 characters)
JWT_SECRET=4f92a105c3b4e78912345678abcdef0123456789abcdef0123456789abcdef2026

# Optional: Default SuperAdmin initial provisioning password
# If set, SuperAdminSeeder creates/updates admin@intellicampus.edu on startup
SUPERADMIN_PASSWORD=

# ---------------------------------------------------------------------
# Redis & Microservice Configuration (Optional for Auth/Core Modules)
# ---------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
AI_SERVICE_URL=http://localhost:8000
